# ============================================
# BookCommerce - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================

# ---- Aplicação ----
APP_NAME=BookCommerce API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Banco de Dados ----
DATABASE_URL=postgresql+psycopg2://bookcommerce:bookcommerce@localhost:5432/bookcommerce
TEST_DATABASE_URL=postgresql+psycopg2://bookcommerce:bookcommerce@localhost:5432/bookcommerce_test

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Segurança ----
SECRET_KEY=change-me-to-a-random-64-char-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Upload de Imagens ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true

# ---- E-mail (será usado na Fase 2) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=