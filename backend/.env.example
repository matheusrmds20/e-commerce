# ============================================
# BookCommerce - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================

# ---- Aplicação ----
APP_NAME=BookCommerce API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- Banco de Dados ----
# Gere uma senha forte; o docker-compose exige POSTGRES_PASSWORD (sem default).
POSTGRES_USER=bookcommerce
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://bookcommerce:bookcommerce@localhost:5432/bookcommerce
TEST_DATABASE_URL=postgresql+psycopg2://bookcommerce:bookcommerce@localhost:5432/bookcommerce_test
# Banco usado pelos testes E2E e por backend/scripts/e2e_server.py.
E2E_DATABASE_URL=postgresql+psycopg2://bookcommerce:bookcommerce@localhost:5433/bookcommerce-e2e

# ---- Supabase Storage (comprovantes em PDF) ----
# As tasks de comprovante geram o PDF em memória e enviam para o Supabase
# Storage (bucket privado), em vez de gravar em disco. Assim worker (celery)
# e API (uvicorn) compartilham o mesmo armazenamento.
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_SERVICE_KEY=eyJ... (service_role, só server-side — nunca no front)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Bucket privado criado no dashboard do Supabase (Storage -> New bucket).
SUPABASE_STORAGE_BUCKET=comprovantes

# ---- Usuário administrador (scripts/seed.py) ----
# O seed cria/sincroniza o admin.
#
# Em produção (DEBUG=false) o seed RECUSA rodar se ADMIN_PASSWORD estiver no
# default público ('Admin@123') ou se ADMIN_EMAIL for 'admin@papiro.com' —
# evita criar um admin com senha conhecida numa API exposta.
# Os defaults abaixo só valem com DEBUG=true (desenvolvimento local).
#
# Política conservadora: em usuário já existente a senha NÃO é sobrescrita;
# para forçar a troca rode `python -m scripts.seed --reset-passwords`.
ADMIN_EMAIL=admin@papiro.com
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=Administrador Papiro

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Segurança ----
# SECRET_KEY assina os JWT (HS256). Quem a descobre forja token de admin SEM
# senha. Como HS256 é simétrico (a mesma chave assina e verifica), não existe
# chave pública para proteger você.
#
# Em produção (DEBUG=false) o startup da API RECUSA subir se a chave for:
#   - o placeholder abaixo;
#   - menor que 32 caracteres;
#   - uma repetição/padrão curto ("a"*64, "abcabc...", "senha"*8);
#   - de baixa variedade de caracteres (entropia estimada < 128 bits).
#
# Gere uma chave forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ATENÇÃO: trocar a chave invalida todos os tokens e refresh tokens emitidos;
# todos os usuários precisarão logar de novo.
SECRET_KEY=change-me-to-a-random-64-char-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- CORS ----
# Lista JSON de origens permitidas. Precisa incluir o front que chama a API.
# O default do código (app/core/config.py) já cobre localhost:5173/4173 e os
# domínios de produção; ajuste aqui só se usar outros domínios.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://papiro.matheuslab.xyz"]

# ---- Upload de Imagens ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ---- Rate Limiting ----
# Proteção por-IP via slowapi. Rotas sensíveis (auth, newsletter, webhook...)
# têm limites próprios definidos no código (app/api/limiter.py).
RATE_LIMIT_ENABLED=true
# Limite padrão (todas as rotas sem limite explícito).
# Sintaxe do limits: "<quantidade>/<segundo|minute|hour|day>"
RATE_LIMIT_DEFAULT="200/minute"
# "memory://" é por-processo (dev). Em produção com múltiplos workers use Redis,
# ex.: o mesmo Upstash do Celery num db index separado, redis://.../2
RATE_LIMIT_STORAGE_URI="memory://"
# Falso: nunca confiar no header X-Forwarded-For (controlável pelo cliente).
RATE_LIMIT_TRUST_XFF=false

# ---- Lockout de login por conta (P1-5) ----
# Complementa o rate limit por IP contra credential stuffing distribuído.
# O Redis pode ser o do Celery (ou LOGIN_LOCKOUT_REDIS_URL separado).
LOGIN_LOCKOUT_ENABLED=true
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_TTL_SECONDS=300
LOGIN_LOCKOUT_BASE_SECONDS=300
LOGIN_LOCKOUT_MAX_SECONDS=1800
# Se vazio, deriva de CELERY_BROKER_URL. Use um db index separado do Upstash.
LOGIN_LOCKOUT_REDIS_URL=

# ---- Cookies de sessão (P0-2) ----
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- E-mail (será usado na Fase 2) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# ---- Mercado Pago ----
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Secrets extras (separados por vírgula) para quando mais de uma aplicação do
# Mercado Pago envia webhooks para a mesma URL.
MERCADO_PAGO_WEBHOOK_SECRETS_EXTRA=
# Desligada neste projeto de portfólio (o webhook consulta o MP via API direto;
# ver ADR-002). Só reative com true em produção com pagamentos reais.
VALIDATE_WEBHOOK_SIGNATURE=false

# ---- Melhor Envio (cálculo de frete) ----
# Token OAuth2 gerido em https://painel.melhorenvio.com.br (Integrações > Área Dev).
# Deixe vazio para desativar a cotação real (fallback offline no serviço).
MELHOR_ENVIO_API_TOKEN=
# CEP de origem (da loja) usado na cotação; sem o hífen, ex.: 01001000.
MELHOR_ENVIO_ORIGIN_ZIP=
# true => sandbox.melhorenvio.com.br (Correios/Jadlog); false => produção.
MELHOR_ENVIO_SANDBOX=true
